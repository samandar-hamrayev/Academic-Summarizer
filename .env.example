# Copy to .env and fill in the blanks:  cp .env.example .env
# Never commit the real .env file.

# ── Django ───────────────────────────────────────────────────────────────────
# Generate: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
# Defaults to False. Set to True only for local development.
DEBUG=False
# Comma- or space-separated hostnames Django will serve.
ALLOWED_HOSTS=localhost,127.0.0.1
# Full origins (scheme://host:port) allowed to POST forms, e.g. http://localhost:18180
CSRF_TRUSTED_ORIGINS=http://localhost:18180,http://127.0.0.1:18180
# Set True when running behind nginx (it sets X-Forwarded-Proto / Host).
TRUST_PROXY_HEADERS=False
LOG_LEVEL=INFO

# ── HTTPS hardening (enable when served over TLS) ────────────────────────────
SECURE_COOKIES=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# ── Database ─────────────────────────────────────────────────────────────────
# Leave empty to use SQLite locally. docker-compose builds it from POSTGRES_*.
DATABASE_URL=
DB_CONN_MAX_AGE=600
POSTGRES_DB=academic_summarizer
POSTGRES_USER=django
POSTGRES_PASSWORD=

# ── Groq LLM ─────────────────────────────────────────────────────────────────
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
# Any supported chat model: https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT=45
GROQ_MAX_RETRIES=2

# ── Uploads ──────────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=50

# ── Docker ───────────────────────────────────────────────────────────────────
# Host port nginx is published on (bound to 127.0.0.1).
HTTP_PORT=18180
GUNICORN_WORKERS=3
GUNICORN_THREADS=4
# Must exceed GROQ_TIMEOUT x (GROQ_MAX_RETRIES + 1); keep nginx proxy_read_timeout in sync.
GUNICORN_TIMEOUT=180
